# Sync Groups Configuration
# Copy this file to sync_groups.toml and customize as needed.
# Groups defined here will be automatically created on startup.

# Example: Living room display with nature photos
[groups.living-room]
duration = 60                              # Cycle duration in seconds (5-3600)
folders = "/photos/nature,/photos/landscape"  # Comma-separated folder paths
recursive = true                           # Search subfolders
width = 1920                               # Target width (optional)
height = 1080                              # Target height (optional)
preserve_aspect = true                     # Preserve aspect ratio
mode = "fit"                               # "fit" or "crop"
pad_color = "black"                        # Letterbox padding color

# Example: E-Ink display with art photos
[groups.bedroom-eink]
duration = 300
folders = "/photos/art"
eink = true                                # Enable E-Ink color mapping
saturation = 2.5                           # E-Ink saturation (default: 2.5)
contrast = 1.2                             # E-Ink contrast (default: 1.2)
brightness = 1.1                           # E-Ink brightness (default: 1.1)
sharpen = true                             # E-Ink sharpening

# Example: Kitchen display with quick rotation
[groups.kitchen]
duration = 30
folders = "/photos/food"
recursive = false
