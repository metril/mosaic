# Screensaver Application Environment Configuration

# Base URL for the application (including protocol and domain)
# Leave empty to use dynamic detection based on incoming requests
# Example: https://screensaver.azureolympos.com
BASE_URL=https://screensaver.azureolympos.com

# =============================================================================
# Image Configuration
# =============================================================================

# Directory containing images (inside container)
# Default: /www/images
IMAGE_DIR=/www/images

# Thumbnail size for browse interface (pixels)
# Default: 200
THUMBNAIL_SIZE=200

# Maximum image dimension (width/height) to prevent memory exhaustion
# Default: 8192
MAX_IMAGE_DIMENSION=8192

# =============================================================================
# Path Security
# =============================================================================

# Maximum folder path depth
# Default: 10
MAX_PATH_DEPTH=10

# Maximum path length in characters
# Default: 255
MAX_PATH_LENGTH=255

# =============================================================================
# E-Ink Processing Defaults
# =============================================================================

# Default saturation multiplier for E-Ink color mapping
# Range: 0.0-10.0, Default: 2.5
EINK_SATURATION=2.5

# Default contrast multiplier for E-Ink color mapping
# Range: 0.0-5.0, Default: 1.2
EINK_CONTRAST=1.2

# Default brightness multiplier for E-Ink color mapping
# Range: 0.0-5.0, Default: 1.1
EINK_BRIGHTNESS=1.1

# Apply sharpening for E-Ink preprocessing
# Default: true
EINK_SHARPEN=true

# =============================================================================
# Application Settings
# =============================================================================

# Uvicorn log level
# Options: debug, info, warning, error, critical
# Default: info
LOG_LEVEL=info

# =============================================================================
# Home Assistant Integration (for clock/weather overlays)
# =============================================================================

# Home Assistant base URL (e.g., http://homeassistant.local:8123)
# Leave empty to disable Home Assistant integration
HOMEASSISTANT_URL=

# Home Assistant long-lived access token
# Generate at: Home Assistant → Profile → Long-Lived Access Tokens
HOMEASSISTANT_TOKEN=

# =============================================================================
# Authentication (OIDC)
# =============================================================================

# OpenID Connect issuer URL (e.g., https://keycloak.example.com/realms/myrealm)
# Leave empty to disable authentication
OIDC_ISSUER=

# OIDC client ID
OIDC_CLIENT_ID=

# OIDC client secret
OIDC_CLIENT_SECRET=

# OIDC redirect URI (must match your OIDC provider configuration)
# Example: https://screensaver.example.com/auth/callback
OIDC_REDIRECT_URI=

# Secret key for session encryption (32+ random characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# =============================================================================
# Security Settings
# =============================================================================

# Allowed CORS origins (comma-separated)
# Use * for development, specific domains for production
# Default: *
ALLOWED_ORIGINS=*

# Allowed WebSocket origins (comma-separated)
# Should match your domain(s) for production
ALLOWED_WS_ORIGINS=

# Require HTTPS for secure cookies
# Set to true in production with TLS termination
# Default: false
HTTPS_ONLY=false

# =============================================================================
# Iframe Embedding (for Wallpanel, Home Assistant, etc.)
# =============================================================================

# Allow display pages to be embedded in iframes
# Set to "true" to enable embedding for Wallpanel or similar integrations
# Only affects display routes (/display, /api/image/*), admin remains protected
# Default: false
ALLOW_FRAME_EMBEDDING=false

# Restrict which origins can embed the display (space-separated)
# Leave empty to allow any origin when ALLOW_FRAME_EMBEDDING=true
# Example: "https://homeassistant.local:8123 https://ha.example.com"
FRAME_ANCESTORS=

# =============================================================================
# Connection Limits
# =============================================================================

# Maximum browsers per sync group
# Default: 100
MAX_BROWSERS_PER_GROUP=100

# Maximum number of sync groups
# Default: 50
MAX_GROUPS=50

# =============================================================================
# Display Endpoint Cleanup
# =============================================================================

# Time before anonymous display endpoints are removed when disconnected
# Supports flexible duration formats: "30m", "24h", "7d", "1w", "2h30m"
# Or plain number for seconds. Set to "0" to disable cleanup.
# Default: 24h
ENDPOINT_CLEANUP=24h
