# Screensaver Application Environment Configuration

# Base URL for the application (including protocol and domain)
# Leave empty to use dynamic detection based on incoming requests
# Example: https://screensaver.azureolympos.com
BASE_URL=https://screensaver.azureolympos.com

# =============================================================================
# Image Configuration
# =============================================================================

# Directory containing images (inside container)
# Default: /www/images
IMAGE_DIR=/www/images

# Thumbnail size for browse interface (pixels)
# Default: 200
THUMBNAIL_SIZE=200

# Thumbnail cache directory (inside container)
# Default: /www/thumbnails
THUMBNAIL_CACHE_DIR=/www/thumbnails

# Thumbnail output format (WEBP, JPEG, PNG)
# WEBP is ~30% smaller than JPEG at equivalent quality
# Default: WEBP
THUMBNAIL_FORMAT=WEBP

# Thumbnail compression quality (1-100)
# Default: 80
THUMBNAIL_QUALITY=80

# Maximum image dimension (width/height) to prevent memory exhaustion
# Default: 8192
MAX_IMAGE_DIMENSION=8192

# =============================================================================
# Path Security
# =============================================================================

# Maximum folder path depth
# Default: 10
MAX_PATH_DEPTH=10

# Maximum path length in characters
# Default: 255
MAX_PATH_LENGTH=255

# =============================================================================
# E-Ink Processing Defaults
# =============================================================================

# Default saturation multiplier for E-Ink color mapping
# Range: 0.0-10.0, Default: 2.5
EINK_SATURATION=2.5

# Default contrast multiplier for E-Ink color mapping
# Range: 0.0-5.0, Default: 1.2
EINK_CONTRAST=1.2

# Default brightness multiplier for E-Ink color mapping
# Range: 0.0-5.0, Default: 1.1
EINK_BRIGHTNESS=1.1

# Apply sharpening for E-Ink preprocessing
# Default: true
EINK_SHARPEN=true

# =============================================================================
# Application Settings
# =============================================================================

# Uvicorn log level
# Options: debug, info, warning, error, critical
# Default: info
LOG_LEVEL=info

# Admin session lifetime in seconds
# After this duration, users must re-authenticate via OIDC
# Default: 3600 (1 hour)
SESSION_MAX_AGE=3600

# =============================================================================
# Timeouts
# =============================================================================

# Timeout in seconds for HTTP requests to the Immich server
# Covers asset search, download, and connection test requests
# Default: 30
IMMICH_HTTP_TIMEOUT=30

# Timeout in seconds for HTTP requests to Home Assistant
# Covers weather and time data fetching
# Default: 10
HA_HTTP_TIMEOUT=10

# Timeout in seconds for sending messages to connected browsers via WebSocket
# Browsers that don't respond within this window are considered unresponsive
# Default: 5
WEBSOCKET_SEND_TIMEOUT=5

# =============================================================================
# Cache & Cleanup
# =============================================================================

# Time-to-live in seconds for cached Home Assistant weather data
# Reduces API calls to HA by serving cached responses within this window
# Default: 600 (10 minutes)
HA_WEATHER_CACHE_TTL=600

# Browser cache duration in seconds for static assets (images, thumbnails, fonts)
# Sent as the Cache-Control: max-age header
# Default: 86400 (1 day)
STATIC_CACHE_MAX_AGE=86400

# Interval in seconds between stale browser connection cleanup runs
# Default: 30
CLEANUP_INTERVAL=30

# Time in seconds after which a disconnected browser is considered stale
# and removed from its display group
# Default: 60
BROWSER_STALE_TIMEOUT=60

# =============================================================================
# Processing
# =============================================================================

# Number of CPU processes used for parallel thumbnail generation
# Higher values speed up pre-generation but use more memory
# Default: 2
THUMBNAIL_MAX_WORKERS=2

# JPEG compression quality (1-100) used when processing/resizing images
# Higher values produce better quality but larger files
# Default: 95
IMAGE_JPEG_QUALITY=95

# Delay in seconds after detecting a file change before triggering
# thumbnail regeneration. Prevents redundant work during bulk file
# operations (e.g., an Immich pull downloading many files)
# Default: 2.0
FILE_WATCHER_DEBOUNCE=2.0

# =============================================================================
# Immich
# =============================================================================

# Maximum number of images allowed per Immich pull operation
# Enforced in both the API validation and the admin UI form
# Default: 1000
MAX_IMMICH_PULL_COUNT=1000

# =============================================================================
# Display
# =============================================================================

# Maximum number of images kept in each browser's history stack
# Enables the "previous image" feature
# Default: 100
MAX_IMAGE_HISTORY=100

# Seconds before a scheduled image switch to send the preload command
# Allows browsers to fetch the next image in advance for smooth transitions
# Default: 5
PRELOAD_LEAD_TIME=5

# =============================================================================
# Home Assistant Integration (for clock/weather overlays)
# =============================================================================

# Home Assistant base URL (e.g., http://homeassistant.local:8123)
# Leave empty to disable Home Assistant integration
HOMEASSISTANT_URL=

# Home Assistant long-lived access token
# Generate at: Home Assistant → Profile → Long-Lived Access Tokens
HOMEASSISTANT_TOKEN=

# =============================================================================
# Authentication (OIDC)
# =============================================================================

# OpenID Connect issuer URL (e.g., https://keycloak.example.com/realms/myrealm)
# Leave empty to disable authentication
OIDC_ISSUER=

# OIDC client ID
OIDC_CLIENT_ID=

# OIDC client secret
OIDC_CLIENT_SECRET=

# OIDC redirect URI (must match your OIDC provider configuration)
# Example: https://screensaver.example.com/auth/callback
OIDC_REDIRECT_URI=

# Secret key for session encryption (32+ random characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Display name for the OIDC provider (shown on login button)
# Examples: "Authentik", "Keycloak", "Okta", "Google"
# Default: SSO
OIDC_PROVIDER_NAME=

# =============================================================================
# Security Settings
# =============================================================================

# Allowed CORS origins (comma-separated)
# Use * for development, specific domains for production
# Default: *
ALLOWED_ORIGINS=*

# Allowed WebSocket origins (comma-separated)
# Should match your domain(s) for production
ALLOWED_WS_ORIGINS=

# Require HTTPS for secure cookies
# Set to true in production with TLS termination
# Default: false
HTTPS_ONLY=false

# =============================================================================
# Iframe Embedding (for Wallpanel, Home Assistant, etc.)
# =============================================================================

# Allow display pages to be embedded in iframes
# Set to "true" to enable embedding for Wallpanel or similar integrations
# Only affects display routes (/display, /api/image/*), admin remains protected
# Default: false
ALLOW_FRAME_EMBEDDING=false

# Restrict which origins can embed the display (space-separated)
# Leave empty to allow any origin when ALLOW_FRAME_EMBEDDING=true
# Example: "https://homeassistant.local:8123 https://ha.example.com"
FRAME_ANCESTORS=

# =============================================================================
# Connection Limits
# =============================================================================

# Maximum browsers per sync group
# Default: 100
MAX_BROWSERS_PER_GROUP=100

# Maximum number of sync groups
# Default: 50
MAX_GROUPS=50

# =============================================================================
# Display Endpoint Cleanup
# =============================================================================

# Time before anonymous display endpoints are removed when disconnected
# Supports flexible duration formats: "30m", "24h", "7d", "1w", "2h30m"
# Or plain number for seconds. Set to "0" to disable cleanup.
# Default: 24h
ENDPOINT_CLEANUP=24h

# =============================================================================
# API Keys (for Image Serving)
# =============================================================================
#
# When OIDC is enabled, image serving endpoints require authentication.
# API keys allow display devices and external integrations to access images
# without browser-based OIDC login.
#
# API keys are managed via the admin dashboard:
#   - Open /admin and click the key icon in the header
#   - Keys are shown only once on creation - save them securely
#   - Keys can be revoked at any time
#
# Usage:
#   - HTTP header: Authorization: Bearer sk_xxxxxxxxxxxx
#   - Display URL: /display?group=xxx&endpoint=yyy&key=sk_xxxxxxxxxxxx
#
# API keys are stored in config/api_keys.yaml (created automatically)
