# Screensaver Application Environment Configuration

# Base URL for the application (including protocol and domain)
# Leave empty to use dynamic detection based on incoming requests
# Example: https://screensaver.azureolympos.com
BASE_URL=https://screensaver.azureolympos.com

# =============================================================================
# Image Configuration
# =============================================================================

# Directory containing images (inside container)
# Default: /www/images
IMAGE_DIR=/www/images

# Thumbnail size for browse interface (pixels)
# Default: 200
THUMBNAIL_SIZE=200

# Maximum image dimension (width/height) to prevent memory exhaustion
# Default: 8192
MAX_IMAGE_DIMENSION=8192

# =============================================================================
# Path Security
# =============================================================================

# Maximum folder path depth
# Default: 10
MAX_PATH_DEPTH=10

# Maximum path length in characters
# Default: 255
MAX_PATH_LENGTH=255

# =============================================================================
# E-Ink Processing Defaults
# =============================================================================

# Default saturation multiplier for E-Ink color mapping
# Range: 0.0-10.0, Default: 2.5
EINK_SATURATION=2.5

# Default contrast multiplier for E-Ink color mapping
# Range: 0.0-5.0, Default: 1.2
EINK_CONTRAST=1.2

# Default brightness multiplier for E-Ink color mapping
# Range: 0.0-5.0, Default: 1.1
EINK_BRIGHTNESS=1.1

# Apply sharpening for E-Ink preprocessing
# Default: true
EINK_SHARPEN=true

# =============================================================================
# Application Settings
# =============================================================================

# Uvicorn log level
# Options: debug, info, warning, error, critical
# Default: info
LOG_LEVEL=info
